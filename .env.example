# beispiel-config
# in .env kopieren und anpassen falls noetig
# fuer den normalen weg reicht das default-setup
# der wizard fragt alle relevanten werte ab und speichert sie in der db

# OPENAI_API_KEY hier nur als fallback fuer skripte ausserhalb der app
# die app liest den eigentlichen embedding-key aus app_config
OPENAI_API_KEY=sk-...

# postgres-verbindung default zeigt auf den docker-service
DATABASE_URL=postgresql://raguser:ragpassword@postgres:5432/ragdb

# ollama-host optional
# default im container zeigt auf host.docker.internal
# OLLAMA_HOST=http://host.docker.internal:11434
