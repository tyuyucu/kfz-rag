# Beispiel-Konfiguration. In `.env` kopieren und anpassen, falls noetig.
# Fuer den normalen Studi-Pfad reicht das Default-Setup ohne `.env` —
# der Erstkonfigurations-Wizard fragt alle relevanten Werte ab und
# speichert sie persistent in der DB.
#
# Diese Datei nutzen, wenn du:
#   - Eval-Skripte ausserhalb der Streamlit-App laufen lassen willst,
#   - oder einen alternativen Postgres-Host verwendest.

# OpenAI-Schluessel — nur fuer die Evaluations-Pipeline relevant.
# Die Streamlit-App liest den Embedding-Schluessel des Studierenden aus
# der `app_config`-Tabelle (gesetzt im Setup-Wizard) und ignoriert diesen
# hier ggf.
OPENAI_API_KEY=sk-...

# Postgres-Verbindung. Default zeigt auf den im docker-compose definierten
# Service. Nur anpassen, wenn du eine externe DB ansprechen willst.
DATABASE_URL=postgresql://raguser:ragpassword@postgres:5432/ragdb

# Ollama-Host (optional). Standard im Container: host.docker.internal,
# damit ein auf der Host-Maschine laufender Ollama-Daemon erreicht wird.
# Auskommentiert lassen, wenn Ollama lokal auf Port 11434 laeuft.
# OLLAMA_HOST=http://host.docker.internal:11434
